# Generated by systemd/install_service.sh, do not edit the installed copy
# View logs with: sudo journalctl -f -u SCRIPT_NAME -o cat

[Unit]
Description=SCRIPT_NAME service
StartLimitIntervalSec=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 SCRIPT_PATH
User=pi

# Restart script if stopped, waiting 30s before restart
Restart=always
RestartSec=30s

SyslogIdentifier=SCRIPT_NAME

[Install]
WantedBy=multi-user.target
